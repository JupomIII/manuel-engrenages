  {
    "id": "table1",
    "title": "Table 1 — Formules des dimensions (p. 2212)",
    "kind": "formulas",
    "groups": [
      {
        "name": "Formules de base",
        "rows": [
          {
            "label": "Diamètre du cercle de base",
            "variants": [
              {
                "display": "DB = D cos φ",
                "expr": "D * cos(phi)",
                "tex": "D_B = D\\cos\\varphi"
              }
            ],
            "when": "Pour tracer la développante ou vérifier la longueur de flanc ; ne sert pas à la taille."
          },
          {
            "label": "Pas circulaire",
            "variants": [
              {
                "display": "p = 3,1416 D / N",
                "expr": "3.1416 * D / N",
                "tex": "p=\\frac{3{,}1416\\,D}{N}"
              },
              {
                "display": "p = 3,1416 / P",
                "expr": "3.1416 / P",
                "tex": "p=\\frac{3{,}1416}{P}"
              }
            ],
            "when": "Dès que P est connu : contrôle de l'avance et de l'épaisseur de dent."
          },
          {
            "label": "Entraxe",
            "variants": [
              {
                "display": "C = N_P (m_G + 1) / (2P)",
                "expr": "NP * (mG + 1) / (2 * P)",
                "tex": "C=\\frac{N_P\\,(m_G+1)}{2P}"
              },
              {
                "display": "C = (D_P + D_G) / 2",
                "expr": "(DP + DG) / 2",
                "tex": "C=\\frac{D_P+D_G}{2}"
              },
              {
                "display": "C = (N_G + N_P) / (2P)",
                "expr": "(NG + NP) / (2 * P)",
                "tex": "C=\\frac{N_G+N_P}{2P}"
              },
              {
                "display": "C = (N_G + N_P) p / 6,2832",
                "expr": "(NG + NP) * p / 6.2832",
                "tex": "C=\\frac{(N_G+N_P)\\,p}{6{,}2832}"
              }
            ],
            "when": "Après les diamètres primitifs, pour vérifier la donnée de départ : C = (D_G + D_P)/2."
          },
          {
            "label": "Pas diamétral",
            "variants": [
              {
                "display": "P = 3,1416 / p",
                "expr": "3.1416 / p",
                "tex": "P=\\frac{3{,}1416}{p}"
              },
              {
                "display": "P = N / D",
                "expr": "N / D",
                "tex": "P=\\frac{N}{D}"
              },
              {
                "display": "P = N_P (m_G + 1) / (2C)",
                "expr": "NP * (mG + 1) / (2 * C)",
                "tex": "P=\\frac{N_P\\,(m_G+1)}{2C}"
              }
            ],
            "when": "Donnée de départ du train, ou déduite du pas circulaire mesuré."
          },
          {
            "label": "Rapport d'engrenage",
            "variants": [
              {
                "display": "m_G = N_G / N_P",
                "expr": "NG / NP",
                "tex": "m_G=\\frac{N_G}{N_P}"
              }
            ],
            "when": "Donnée de départ : m_G = N_G/N_P, sert à répartir l'entraxe entre pignon et roue."
          },
          {
            "label": "Nombre de dents",
            "variants": [
              {
                "display": "N = P × D",
                "expr": "P * D",
                "tex": "N=P\\times D"
              },
              {
                "display": "N = 3,1416 D / p",
                "expr": "3.1416 * D / p",
                "tex": "N=\\frac{3{,}1416\\,D}{p}"
              }
            ],
            "when": "Après le diamètre primitif : N doit être un entier, sinon les données sont incohérentes."
          },
          {
            "label": "Diamètre extérieur (pleine profondeur)",
            "variants": [
              {
                "display": "DO = (N + 2) / P",
                "expr": "(N + 2) / P",
                "tex": "D_0=\\frac{N+2}{P}"
              },
              {
                "display": "DO = (N + 2) p / 3,1416",
                "expr": "(N + 2) * p / 3.1416",
                "tex": "D_0=\\frac{(N+2)\\,p}{3{,}1416}"
              }
            ],
            "when": "Avant la taille : c'est le diamètre de la pièce à tourner (D + 2a)."
          },
          {
            "label": "Diamètre extérieur (American Standard Stub)",
            "variants": [
              {
                "display": "DO = (N + 1,6) / P",
                "expr": "(N + 1.6) / P",
                "tex": "D_0=\\frac{N+1{,}6}{P}"
              },
              {
                "display": "DO = (N + 1,6) p / 3,1416",
                "expr": "(N + 1.6) * p / 3.1416",
                "tex": "D_0=\\frac{(N+1{,}6)\\,p}{3{,}1416}"
              }
            ],
            "when": "Seulement pour une denture trapue (stub), pas pour la denture commune du cours."
          },
          {
            "label": "Diamètre extérieur",
            "variants": [
              {
                "display": "DO = D + 2a",
                "expr": "D + 2 * a",
                "tex": "D_0=D+2a"
              }
            ],
            "when": "Contrôle de la pièce avant la taille : D_0 = D + 2a."
          },
          {
            "label": "Diamètre primitif",
            "variants": [
              {
                "display": "D = N / P",
                "expr": "N / P",
                "tex": "D=\\frac{N}{P}"
              },
              {
                "display": "D = N p / 3,1416",
                "expr": "N * p / 3.1416",
                "tex": "D=\\frac{N\\,p}{3{,}1416}"
              }
            ],
            "when": "Base de tous les autres calculs : D = N/P."
          },
          {
            "label": "Diamètre de pied",
            "variants": [
              {
                "display": "DR = D − 2b",
                "expr": "D - 2 * b",
                "tex": "D_R=D-2b"
              }
            ],
            "when": "Contrôle du pied de dent après la taille."
          },
          {
            "label": "Profondeur totale",
            "variants": [
              {
                "display": "ht = a + b",
                "expr": "a + b",
                "tex": "h_t=a+b"
              }
            ],
            "when": "Profondeur de passe de la fraise : h_t = a + b."
          },
          {
            "label": "Profondeur de travail",
            "variants": [
              {
                "display": "hk = a_G + a_P",
                "expr": "aG + aP",
                "tex": "h_k=a_G+a_P"
              }
            ],
            "when": "Hauteur réellement en prise entre deux dents."
          }
        ]
      }
    ]
  },
  {
    "id": "table2",
    "title": "Table 2 — Proportions de dent 20° et 25° (p. 2212-2213)",
    "kind": "formulas",
    "groups": [
      {
        "name": "Denture pleine profondeur, 20° et 25° (ANSI B6.1-1968)",
        "rows": [
          {
            "label": "Addendum",
            "variants": [
              {
                "display": "a = 1,000 ÷ P",
                "expr": "1 / P",
                "tex": "a=\\frac{1{,}000}{P}"
              },
              {
                "display": "a = 0,3183 p",
                "expr": "0.3183 * p",
                "tex": "a=0{,}3183\\,p"
              }
            ],
            "when": "Hauteur de dent au-dessus du primitif, à respecter au tournage."
          },
          {
            "label": "Dedendum (préféré)",
            "variants": [
              {
                "display": "b = 1,250 ÷ P",
                "expr": "1.25 / P",
                "tex": "b=\\frac{1{,}250}{P}"
              },
              {
                "display": "b = 0,3979 p",
                "expr": "0.3979 * p",
                "tex": "b=0{,}3979\\,p"
              }
            ],
            "when": "Creux de la denture 20°/25° non arasée ; à 14½°, prendre 1,157/P."
          },
          {
            "label": "Dedendum (dents rasées ou rectifiées)",
            "variants": [
              {
                "display": "b = 1,350 ÷ P",
                "expr": "1.35 / P",
                "tex": "b=\\frac{1{,}350}{P}"
              },
              {
                "display": "b = 0,4297 p",
                "expr": "0.4297 * p",
                "tex": "b=0{,}4297\\,p"
              }
            ],
            "when": "Creux quand la dent est rasée ou rectifiée : b = 1,350/P."
          },
          {
            "label": "Profondeur de travail",
            "variants": [
              {
                "display": "hk = 2,000 ÷ P",
                "expr": "2 / P",
                "tex": "h_k=\\frac{2{,}000}{P}"
              },
              {
                "display": "hk = 0,6366 p",
                "expr": "0.6366 * p",
                "tex": "h_k=0{,}6366\\,p"
              }
            ],
            "when": "Hauteur réellement en prise entre deux dents."
          },
          {
            "label": "Profondeur totale (préféré)",
            "variants": [
              {
                "display": "ht = 2,250 ÷ P",
                "expr": "2.25 / P",
                "tex": "h_t=\\frac{2{,}250}{P}"
              },
              {
                "display": "ht = 0,7162 p",
                "expr": "0.7162 * p",
                "tex": "h_t=0{,}7162\\,p"
              }
            ],
            "when": "Profondeur de passe pour une denture 20°/25° non arasée."
          },
          {
            "label": "Profondeur totale (dents rasées ou rectifiées)",
            "variants": [
              {
                "display": "ht = 2,350 ÷ P",
                "expr": "2.35 / P",
                "tex": "h_t=\\frac{2{,}350}{P}"
              },
              {
