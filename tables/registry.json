[
  {
    "id": "protocole",
    "title": "Protocole du guide — étapes 1 à 6 (241-HAL-07)",
    "kind": "formulas",
    "groups": [
      {
        "name": "Étape 1 — diamètres primitifs et nombres de dents",
        "rows": [
          {
            "label": "Rapport de transmission",
            "when": "Donnée de départ du train : m_G = D_G/D_P, sert à répartir l'entraxe.",
            "variants": [
              {
                "display": "m_G = D_G / D_P",
                "tex": "m_G=\\dfrac{D_G}{D_P}",
                "expr": "DG / DP"
              }
            ]
          },
          {
            "label": "Entraxe",
            "when": "Donnée de départ, vérifiée à la fin : C = (D_G + D_P)/2 (contrôle n° 2 du guide).",
            "variants": [
              {
                "display": "C = (D_G + D_P) / 2",
                "tex": "C=\\dfrac{D_G+D_P}{2}",
                "expr": "(DG + DP) / 2"
              }
            ]
          },
          {
            "label": "Diamètre primitif du pignon",
            "when": "Premier calcul du train : mène aux nombres de dents.",
            "variants": [
              {
                "display": "D_P = 2C / (m_G + 1)",
                "tex": "D_P=\\dfrac{2C}{m_G+1}",
                "expr": "2 * C / (mG + 1)"
              }
            ]
          },
          {
            "label": "Diamètre primitif de la roue",
            "when": "Se déduit du pignon par le rapport : D_G = m_G × D_P.",
            "variants": [
              {
                "display": "D_G = m_G × D_P",
                "tex": "D_G=m_G\\times D_P",
                "expr": "mG * DP"
              }
            ]
          },
          {
            "label": "Nombre de dents",
            "when": "Après l'entraxe : N doit être entier, sinon les données sont incohérentes.",
            "variants": [
              {
                "display": "N = P × D",
                "tex": "N=P\\times D",
                "expr": "P * D"
              }
            ]
          }
        ]
      },
      {
        "name": "Étape 2 — denture normalisée",
        "rows": [
          {
            "label": "Diamètre extérieur",
            "when": "Avant la taille : diamètre de la pièce à tourner, D_0 = (N + 2)/P.",
            "variants": [
              {
                "display": "D_0 = (N + 2) / P",
                "tex": "D_0=\\dfrac{N+2}{P}",
                "expr": "(N + 2) / P"
              },
              {
                "display": "D_0 = D + 2a",
                "tex": "D_0=D+2a",
                "expr": "D + 2 * a"
              }
            ]
          },
          {
            "label": "Saillie (addendum)",
            "when": "Hauteur de dent au-dessus du primitif : a = 1/P.",
            "variants": [
              {
                "display": "a = 1 / P",
                "tex": "a=\\dfrac{1}{P}",
                "expr": "1 / P"
              }
            ]
          },
          {
            "label": "Creux (dedendum)",
            "when": "Seul terme qui dépend de l'angle : 1,157/P à 14½°, 1,250/P à 20°.",
            "variants": [
              {
                "display": "b = 1,157 / P (14½°)",
                "tex": "b=\\dfrac{1{,}157}{P}",
                "expr": "1.157 / P"
              },
              {
                "display": "b = 1,250 / P (20°)",
                "tex": "b=\\dfrac{1{,}250}{P}",
                "expr": "1.25 / P"
              }
            ]
          },
          {
            "label": "Pas circulaire",
            "when": "Pour l'épaisseur de dent et le contrôle au vernier.",
            "variants": [
              {
                "display": "p = π / P",
                "tex": "p=\\dfrac{\\pi}{P}",
                "expr": "pi / P"
              }
            ]
          },
          {
            "label": "Épaisseur circulaire",
            "when": "Épaisseur de dent sur l'arc primitif : t = p/2.",
            "variants": [
              {
                "display": "t = p / 2",
                "tex": "t=\\dfrac{p}{2}",
                "expr": "p / 2"
              }
            ]
          },
          {
            "label": "Épaisseur à la corde",
            "when": "Pour mesurer la dent au vernier à engrenage (corde, pas arc).",
            "variants": [
              {
                "display": "T = D sin(90°/N)",
                "tex": "T=D\\sin\\dfrac{90^\\circ}{N}",
                "expr": "D * sin(90 / N)"
              }
            ]
          },
          {
            "label": "Saillie à la corde",
            "when": "Avec T : hauteur de la pige du vernier au-dessus de la corde.",
            "variants": [
              {
                "display": "H = a + (D/2)(1 − cos 90°/N)",
                "tex": "H=a+\\dfrac{D}{2}\\left(1-\\cos\\dfrac{90^\\circ}{N}\\right)",
                "expr": "a + D / 2 * (1 - cos(90 / N))"
              }
            ]
          },
          {
            "label": "Profondeur totale",
            "when": "Profondeur de passe de la fraise : h_t = a + b.",
            "variants": [
              {
                "display": "h_t = a + b",
                "tex": "h_t=a+b",
                "expr": "a + b"
              }
            ]
          }
        ]
      },
      {
        "name": "Étape 4 — piges",
        "rows": [
          {
            "label": "Diamètre de pige",
            "when": "Choix des piges pour une denture extérieure : W = 1,728/P.",
            "variants": [
              {
                "display": "W = 1,728 / P",
                "tex": "W=\\dfrac{1{,}728}{P}",
                "expr": "1.728 / P"
              }
            ]
          },
          {
            "label": "Fonction involute de l'angle de contact",
            "when": "Étape intermédiaire : on cherche l'angle α dont l'involute vaut cette valeur.",
            "variants": [
              {
                "display": "inv α = inv φ + W/(D cos φ) − π/(2N)",
                "tex": "\\operatorname{inv}\\alpha=\\operatorname{inv}\\varphi+\\dfrac{W}{D\\cos\\varphi}-\\dfrac{\\pi}{2N}",
                "expr": "tan(phi) - phi * pi / 180 + 1.728 / (P * D * cos(phi)) - pi / (2 * N)"
              }
            ]
          },
          {
            "label": "Mesure sur piges (nombre pair de dents)",
            "when": "Calcul de secours ; en examen, on lit la table de piges et on divise par P.",
            "variants": [
              {
                "display": "M = D cos φ / cos α + W",
                "tex": "M=\\dfrac{D\\cos\\varphi}{\\cos\\alpha}+W",
                "expr": "D * cos(phi) / cos(alpha) + 1.728 / P"
              }
            ]
          },
          {
            "label": "Mesure sur piges (nombre impair de dents)",
            "when": "Même mesure quand N est impair : les piges ne sont pas diamétralement opposées.",
            "variants": [
              {
                "display": "M = D cos φ cos(90°/N) / cos α + W",
                "tex": "M=\\dfrac{D\\cos\\varphi\\,\\cos\\frac{90^\\circ}{N}}{\\cos\\alpha}+W",
                "expr": "D * cos(phi) * cos(90 / N) / cos(alpha) + 1.728 / P"
              }
            ]
          }
        ]
      },
      {
        "name": "Étape 5 — jeu fonctionnel",
        "rows": [
          {
            "label": "Sensibilité ΔM",
            "when": "Variation de M par 0,001 po d'épaisseur en moins ; sert aux trois lignes suivantes.",
            "variants": [
              {
                "display": "ΔM = 0,001 cos φ / sin α",
                "tex": "\\Delta M=0{,}001\\,\\dfrac{\\cos\\varphi}{\\sin\\alpha}",
                "expr": "0.001 * cos(phi) / sin(alpha)"
              }
            ]
          },
          {
            "label": "M maxi (roue amincie)",
            "when": "Quand le jeu est porté par la roue : M_th − 3ΔM.",
            "variants": [
              {
                "display": "M maxi = M_th − 3ΔM",
                "tex": "M_{max}=M_{th}-3\\,\\Delta M",
                "expr": "Mth - 3 * dM"
              }
            ]
          },
          {
            "label": "M mini (roue amincie)",
            "when": "Limite basse de la roue : M_th − 5ΔM (jeu 0,003 + tolérance 0,002).",
            "variants": [
              {
                "display": "M mini = M_th − 5ΔM",
                "tex": "M_{min}=M_{th}-5\\,\\Delta M",
                "expr": "Mth - 5 * dM"
              }
            ]
          },
          {
            "label": "M mini (pignon intact)",
            "when": "Le pignon n'est pas aminci : seule la tolérance de 0,002 s'applique, M_th − 2ΔM.",
            "variants": [
              {
                "display": "M mini = M_th − 2ΔM",
                "tex": "M_{min}=M_{th}-2\\,\\Delta M",
                "expr": "Mth - 2 * dM"
              }
            ]
          }
        ]
      },
      {
        "name": "Étape 6 — mesure entre dents",
        "rows": [
          {
            "label": "Mesure entre dents",
            "when": "Contrôle au pied à coulisse sur k dents (k lu dans la Table 11).",
            "variants": [
              {
                "display": "M = cos φ [(k − 0,5)π + N inv φ] / P",
                "tex": "M=\\dfrac{\\cos\\varphi\\,[(k-0{,}5)\\pi+N\\operatorname{inv}\\varphi]}{P}",
                "expr": "cos(phi) * ((k - 0.5) * pi + N * (tan(phi) - phi * pi / 180)) / P"
              }
            ]
          }
        ]
      }
    ]
  },
  {
